# Copy to .env.local and fill in. .env.local is git-ignored. Never commit real values.

# Supabase -> Project Settings -> API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public key: the "anon" key, or the newer "publishable" key (sb_publishable_...). Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. The "service_role" key, or the newer "secret" key (sb_secret_...). Server only, never in client code.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET. Server-side pepper mixed into student PINs before Supabase hashes them.
# Generate with:  openssl rand -base64 32
# Changing it later locks every student out until their PINs are reset.
STUDENT_PIN_PEPPER=

# SECRET. Used by the AI teacher (written answers). Server only. If blank or if the call fails, the key-term check is used instead.
ANTHROPIC_API_KEY=

# Used for links and redirects. http://localhost:3000 locally, https://mykidzlearning.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
